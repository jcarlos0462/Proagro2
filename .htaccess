<IfModule mod_rewrite.c>
    RewriteEngine On
    DirectoryIndex index.php

    # Keep legacy local URLs from being used after the production move.
    RewriteCond %{HTTP_HOST} ^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteRule ^(.*)$ https://pro-agroindustria.online/$1 [R=301,L,NE]

    RewriteRule ^$ index.php [L]

    # Expose generated and public assets from the project subfolder.
    RewriteRule ^(build|images|img|js|css|storage)(/.*)?$ public/$1$2 [L]

    # Use the project entry point so the application works from the subfolder root.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
